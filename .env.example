# ── Domaines ────────────────────────────────────────────────────────────────
SITE_DOMAIN=mrcntv.com
ADMIN_DOMAIN=admin.mrcntv.com

# ── Ports ────────────────────────────────────────────────────────────────────
PORT=43749
ADMIN_PORT=43750

# ── Base de données ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/marconnete

# ── Authentification ─────────────────────────────────────────────────────────
JWT_SECRET=changer-cette-valeur-en-production

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_live_
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_

STRIPE_TEST_PUBLIC_KEY=pk_test_
STRIPE_TEST_SECRET_KEY=sk_test_
STRIPE_TEST_WEBHOOK_SECRET=whsec_


# ── EmailJS ───────────────────────────────────────────────────────────────────
EMAILJS_SERVICE_ID=service_...
EMAILJS_TEMPLATE_ID=template_...
EMAILJS_PUBLIC_KEY=...

# ── Colissimo (La Poste Pro — Colissimo Web Services) ────────────────────────
# Obtenez vos identifiants sur : https://www.colissimo.fr/entreprise/
COLISSIMO_LOGIN=0012345
COLISSIMO_PASSWORD=votremotdepasse
COLISSIMO_CONTRACT=0012345

# Adresse boutique (pour les étiquettes expéditeur)
SHOP_ADDRESS=1 rue de votre boutique
SHOP_CITY=Paris
SHOP_ZIP=75001
SHOP_PHONE=0600000000

# ── Google Places API (avis Google) ─────────────────────────────────────────
# Obtenez votre clé sur : https://console.cloud.google.com (activer Places API)
# Place ID : cherchez votre établissement sur https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=AIza...
GOOGLE_PLACE_ID=ChIJ...

# ── Instagram Graph API (feed Instagram) ─────────────────────────────────────
# Créez une app Facebook sur https://developers.facebook.com
# Token valide 60 jours — à renouveler depuis le panel admin
INSTAGRAM_ACCESS_TOKEN=IGQVJx...
INSTAGRAM_USER_ID=123456789

# ── Notifications ────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@lamarconnete.fr
